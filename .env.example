# ====== 邮件推送（SMTP）配置 ======
# 国内推荐 QQ邮箱 / 网易163 / 学校邮箱；海外可用 Gmail / Outlook
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_authorization_code_here   # QQ邮箱是授权码，不是登录密码
MAIL_FROM=your_email@qq.com
MAIL_TO=your_email@qq.com

# ====== 检索参数 ======
# 每天推送几条
DAILY_TOPK=5
# 检索回溯天数（默认 7 天内的新文献）
LOOKBACK_DAYS=7